{
  "name": "meteor-power",
  "displayName": "Meteor Power",
  "description": "Navigate Meteor and Blaze code: go to definition, references, hover and completion for methods, publications, templates and helpers, plus a side panel.",
  "version": "0.1.0",
  "publisher": "riccardofilippozzi",
  "author": {
    "name": "Riccardo Filippozzi"
  },
  "license": "MIT",
  "repository": "https://github.com/riccardoflp/meteor-power",
  "bugs": {
    "url": "https://github.com/riccardoflp/meteor-power/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "meteor",
    "meteorjs",
    "blaze",
    "spacebars",
    "templates",
    "go to definition",
    "navigation"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.meteor/release",
    "workspaceContains:**/.meteor/release"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "meteorPower",
          "title": "Meteor Power",
          "icon": "resources/meteor.svg"
        }
      ]
    },
    "views": {
      "meteorPower": [
        {
          "id": "meteorPower.methods",
          "name": "Methods"
        },
        {
          "id": "meteorPower.publications",
          "name": "Publications"
        },
        {
          "id": "meteorPower.templates",
          "name": "Templates"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "meteorPower.methods",
        "contents": "No Meteor methods found (yet).\n[Reindex workspace](command:meteorPower.refresh)"
      },
      {
        "view": "meteorPower.publications",
        "contents": "No publications found."
      },
      {
        "view": "meteorPower.templates",
        "contents": "No Blaze templates found."
      }
    ],
    "commands": [
      {
        "command": "meteorPower.refresh",
        "title": "Reindex Workspace",
        "category": "Meteor Power",
        "icon": "$(refresh)"
      },
      {
        "command": "meteorPower.showLog",
        "title": "Show Log",
        "category": "Meteor Power",
        "icon": "$(output)"
      },
      {
        "command": "meteorPower.goToMethod",
        "title": "Go to Method…",
        "category": "Meteor Power",
        "icon": "$(search)"
      },
      {
        "command": "meteorPower.goToPublication",
        "title": "Go to Publication…",
        "category": "Meteor Power",
        "icon": "$(search)"
      },
      {
        "command": "meteorPower.goToTemplate",
        "title": "Go to Template…",
        "category": "Meteor Power",
        "icon": "$(search)"
      },
      {
        "command": "meteorPower.switchTemplateFile",
        "title": "Switch Between Template HTML and JS",
        "category": "Meteor Power"
      },
      {
        "command": "meteorPower.rename",
        "title": "Rename Method, Publication, Template or Helper",
        "category": "Meteor Power"
      },
      {
        "command": "meteorPower.templates.showHierarchy",
        "title": "Hierarchical View (Inclusions)",
        "category": "Meteor Power",
        "icon": "$(list-tree)"
      },
      {
        "command": "meteorPower.templates.showFlat",
        "title": "Flat View",
        "category": "Meteor Power",
        "icon": "$(list-flat)"
      },
      {
        "command": "meteorPower.openHtml",
        "title": "Open HTML",
        "icon": "$(code)"
      },
      {
        "command": "meteorPower.openJs",
        "title": "Open JS",
        "icon": "$(symbol-method)"
      },
      {
        "command": "meteorPower.openLocation",
        "title": "Open"
      },
      {
        "command": "meteorPower.selectApp",
        "title": "Show App…",
        "category": "Meteor Power",
        "icon": "$(filter)",
        "enablement": "meteorPower.multiApp"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "meteorPower.goToMethod",
          "when": "view == meteorPower.methods",
          "group": "navigation@1"
        },
        {
          "command": "meteorPower.goToPublication",
          "when": "view == meteorPower.publications",
          "group": "navigation@1"
        },
        {
          "command": "meteorPower.goToTemplate",
          "when": "view == meteorPower.templates",
          "group": "navigation@1"
        },
        {
          "command": "meteorPower.templates.showFlat",
          "when": "view == meteorPower.templates && meteorPower.templatesMode == hierarchy",
          "group": "navigation@2"
        },
        {
          "command": "meteorPower.templates.showHierarchy",
          "when": "view == meteorPower.templates && meteorPower.templatesMode != hierarchy",
          "group": "navigation@2"
        },
        {
          "command": "meteorPower.selectApp",
          "when": "view =~ /^meteorPower\\./ && meteorPower.multiApp",
          "group": "navigation@0"
        },
        {
          "command": "meteorPower.refresh",
          "when": "view =~ /^meteorPower\\./",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "meteorPower.openHtml",
          "when": "view == meteorPower.templates && viewItem =~ /^template.*\\.html/",
          "group": "inline@1"
        },
        {
          "command": "meteorPower.openJs",
          "when": "view == meteorPower.templates && viewItem =~ /^template.*\\.js/",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "meteorPower.rename",
          "when": "meteorPower.canRename",
          "group": "1_modification@1"
        },
        {
          "command": "meteorPower.switchTemplateFile",
          "when": "resourceExtname =~ /^\\.(html|js|jsx|ts|tsx|mjs)$/",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "meteorPower.openHtml",
          "when": "false"
        },
        {
          "command": "meteorPower.openJs",
          "when": "false"
        },
        {
          "command": "meteorPower.openLocation",
          "when": "false"
        },
        {
          "command": "meteorPower.templates.showFlat",
          "when": "false"
        },
        {
          "command": "meteorPower.templates.showHierarchy",
          "when": "false"
        },
        {
          "command": "meteorPower.selectApp",
          "when": "meteorPower.multiApp"
        }
      ]
    },
    "keybindings": [
      {
        "command": "meteorPower.switchTemplateFile",
        "key": "alt+o",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(html|js|jsx|ts|tsx|mjs)$/"
      },
      {
        "command": "meteorPower.rename",
        "key": "f2",
        "when": "editorTextFocus && !editorReadonly && meteorPower.canRename"
      }
    ],
    "configuration": {
      "title": "Meteor Power",
      "properties": {
        "meteorPower.include": {
          "type": "string",
          "default": "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,html}",
          "description": "Glob of the files to index."
        },
        "meteorPower.packageDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders of local Meteor packages **outside the workspace** to index too, like `METEOR_PACKAGE_DIRS` (which is also read). Relative paths start from the first workspace folder. Packages inside the workspace are always indexed."
        },
        "meteorPower.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.meteor/local/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/bundle/**",
            "**/public/**",
            "**/coverage/**",
            "**/*.min.js"
          ],
          "description": "Globs of the files to exclude from indexing. `public/` is excluded because Meteor serves it as static files (its HTML is not Blaze)."
        },
        "meteorPower.methods.defineFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Your own functions that **define** Meteor methods (wrappers around `Meteor.methods`). Supported shapes: `fn('name', handler)`, `fn('name', { run })`, `fn({ name: 'x', run() {} })`, `fn({ 'a.b'() {}, 'a.c'() {} })`, also with `new`. Use the bare name to match `fn(...)` and `obj.fn(...)`, or the full path (`Api.fn`) to match only that.\n\nExample: `[\"createMethod\", \"defineMethods\"]`"
        },
        "meteorPower.methods.callFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Your own functions that **call** Meteor methods with the name as first argument (wrappers around `Meteor.callAsync`): `fn('name', ...args)` or `fn({ name: 'x', ... })`.\n\nExample: `[\"callMethod\", \"Api.call\"]`"
        },
        "meteorPower.publications.defineFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Your own functions that **define** publications (wrappers around `Meteor.publish`). Same shapes as `#meteorPower.methods.defineFunctions#`.\n\nExample: `[\"createPublication\"]`"
        },
        "meteorPower.publications.subscribeFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Your own functions that **subscribe** to publications with the name as first argument (wrappers around `Meteor.subscribe`).\n\nExample: `[\"useSubscribe\", \"subscribeTo\"]`"
        },
        "meteorPower.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens (call counts, HTML/JS links) above methods, publications and templates."
        },
        "meteorPower.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report calls to undefined methods/publications and inclusions of undefined templates."
        },
        "meteorPower.diagnostics.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "description": "Severity of the reported problems."
        },
        "meteorPower.diagnostics.ignoreMethods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Methods not to report even if they are not defined in the workspace (e.g. defined by packages). Supports * as a wildcard, e.g. \"accounts.*\"."
        },
        "meteorPower.diagnostics.ignorePublications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Publications not to report. Supports * as a wildcard."
        },
        "meteorPower.diagnostics.ignoreTemplates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "loginButtons",
            "atForm"
          ],
          "description": "Templates not to report (e.g. provided by Atmosphere packages). Supports * as a wildcard."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test out/test/unit.test.js",
    "test:integration": "node esbuild.mjs --tests && node out/test/integration/run.js",
    "screenshots": "node esbuild.mjs --tests && node out/test/screenshots/run.js",
    "package": "vsce package"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
